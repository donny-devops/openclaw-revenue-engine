# =============================================================================
# openclaw-revenue-engine — Environment Variables
# Copy to .env and fill in your values. Never commit .env to source control.
# =============================================================================

# Application
NODE_ENV=development
PORT=3000
API_VERSION=v1
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/revenue_engine
DB_HOST=localhost
DB_PORT=5432
DB_NAME=revenue_engine
DB_USER=postgres
DB_PASSWORD=change_me_in_production
DB_POOL_MIN=2
DB_POOL_MAX=10

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_API_VERSION=2024-06-20
STRIPE_SUCCESS_URL=http://localhost:3000/revenue/payments/{CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/revenue/checkout/canceled
# Use simulated checkout when a live Stripe key is not available
STRIPE_MODE=simulated

# Authentication
JWT_SECRET=change_me_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
OPERATOR_API_KEY=change_me_to_a_long_random_operator_key

# Clerk webhook ingress (src/webhooks/clerk.webhook.ts). Required in any
# environment that receives real Clerk webhooks or forwarded edge traffic —
# unset either and POST /webhooks/clerk fails closed rather than accepting a
# known test value.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_real_clerk_signing_secret_here
# Shared secret used to verify the x-service-signature header on requests
# forwarded from the cloudflare-autonomous-ops edge worker's queue consumer.
# Must match that Worker's INTERNAL_SERVICE_SECRET exactly.
INTERNAL_SERVICE_SECRET=change_me_to_a_long_random_shared_secret

# GitHub Webhooks
GITHUB_WEBHOOK_SECRET=change_me_to_a_random_secret

# Moltgate polling
MOLTGATE_API_KEY=your_moltgate_api_key_here
MOLTGATE_BASE_URL=https://moltgate.com
MOLTGATE_PROFILE_HANDLE=your_profile_handle
REVENUE_ENGINE_URL=http://localhost:3000

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis (optional — for session/cache)
REDIS_URL=redis://localhost:6379

# Monitoring / Alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
ALERT_EMAIL=alerts@yourdomain.com
